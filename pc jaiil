-- ===== finder: acha a state table do anti-cheat =====
local findCache = { busy=false, nextAt=0, misses=0, found=nil }

local function walkForState(root, plr, hum, hrp, depth, seen)
    if depth > 3 or type(root) ~= "table" or seen[root] then return nil end
    seen[root] = true
    if rawget(root,"Player") == plr
    and rawget(root,"Character") == plr.Character
    and rawget(root,"Humanoid") == hum
    and rawget(root,"RootPart") == hrp
    and type(rawget(root,"SampleHistory")) == "table"
    and type(rawget(root,"Evidence")) == "table" then
        return root
    end
    local n = 0
    for _, v in pairs(root) do
        n += 1
        if n > 128 then break end
        if type(v) == "table" then
            local hit = walkForState(v, plr, hum, hrp, depth+1, seen)
            if hit then return hit end
        end
    end
    return nil
end

local function findStateNow(plr, hum, hrp)
    -- 1) getcallbackvalue walk (preferido)
    if type(getcallbackvalue) == "function"
    and type(debug) == "table" and type(debug.getupvalue) == "function" then
        local Signal = ReplicatedStorage:FindFirstChild("Packages")
            and ReplicatedStorage.Packages:FindFirstChild("Signal")
        if Signal then
            local ok, sig = pcall(require, Signal)
            if ok and type(sig) == "table" and type(sig.Invoked) == "function" then
                local ok2, node = pcall(sig.Invoked, "ClientCharacter: GetDebugSnapshot")
                if ok2 and node then
                    local ok3, cb = pcall(getcallbackvalue, node, "OnInvoke")
                    if ok3 and type(cb) == "function" then
                        local ok4, info = pcall(debug.getinfo, cb)
                        if ok4 then
                            for i = 1, (info.nups or 0) do
                                local ok5, upv = pcall(debug.getupvalue, cb, i)
                                if ok5 and type(upv) == "table" then
                                    local hit = walkForState(upv, plr, hum, hrp, 0, {})
                                    if hit then return hit end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    -- 2) fallback getgc
    if type(getgc) == "function" then
        local ok, gc = pcall(getgc, true)
        if ok and type(gc) == "table" then
            for _, v in ipairs(gc) do
                if type(v) == "table"
                and rawget(v,"Player") == plr
                and rawget(v,"Character") == plr.Character
                and rawget(v,"Humanoid") == hum
                and rawget(v,"RootPart") == hrp
                and type(rawget(v,"SampleHistory")) == "table"
                and type(rawget(v,"Evidence")) == "table" then
                    return v
                end
            end
        end
    end
    return nil
end

local function findStateThrottled(plr, hum, hrp)
    local c = findCache
    if type(c.found) == "table"
    and rawget(c.found,"Player") == plr
    and rawget(c.found,"Character") == plr.Character
    and rawget(c.found,"Humanoid") == hum
    and rawget(c.found,"RootPart") == hrp then
        return c.found
    end
    if c.busy or os.clock() < c.nextAt then return nil end
    c.busy = true
    task.spawn(function()
        task.wait()
        local ok, res = pcall(findStateNow, plr, hum, hrp)
        c.found  = ok and res or nil
        c.misses = res and 0 or (c.misses + 1)
        c.nextAt = os.clock() + (res and 0.2 or (c.misses >= 5 and 10 or 1))
        c.busy   = false
    end)
    return nil
end

-- ===== apply integrity: reescreve todos os campos da state =====
local function applyIntegrity(state, speed, travelVel)
    if type(state) ~= "table" then return false end
    local rp = rawget(state,"RootPart")
    local cf = rp and rp.Parent and rp.CFrame or nil
    local pos = cf and cf.Position or nil
    local tv = typeof(travelVel) == "Vector3" and travelVel or Vector3.zero

    local function write(t)
        if type(t) ~= "table" then return end
        rawset(t, "WalkSpeed", speed)
        if cf then
            rawset(t, "CFrame", cf)
            rawset(t, "Position", pos)
            rawset(t, "LinearVelocity", tv)
            rawset(t, "AngularVelocity", Vector3.zero)
        end
    end

    for _, f in ipairs(FIELDS) do write(rawget(state, f)) end

    for _, v in pairs(rawget(state,"SampleHistory") or {}) do write(v) end
    for _, v in pairs(rawget(state,"SafeGroundCheckpoints") or {}) do write(v) end

    local ev = rawget(state,"Evidence")
    if type(ev) == "table" then
        ev.Speed = 0; ev.Teleport = 0; ev.Flight = 0
    end

    local imp = rawget(state,"ImpulseContext")
    if type(imp) == "table" then
        local maxHS = math.max(tonumber(imp.MaxHorizontalSpeed) or 0, speed)
        local span  = math.max((tonumber(imp.ExpiresAt) or 0) - (tonumber(imp.StartedAt) or 0), CLAMP)
        imp.MaxHorizontalSpeed = maxHS
        if pos then imp.OriginPosition = pos end
        imp.MaxHorizontalDistance = math.max(tonumber(imp.MaxHorizontalDistance) or 0, maxHS * span + PADDING * 2)
        write(imp.PreMovementSafeSample)
    end

    if rawget(state,"CorrectionContext") == nil then
        rawset(state, "FirstSuspiciousAt", nil)
        if rawget(state,"ThreatLevel") == "Observing" then
            rawset(state, "ThreatLevel", "Trusted")
        end
    end

    return true
end

local function integrityBox()
    local g = genv
    local b = g[INTEGRITY_KEY]
    if type(b) ~= "table" or b.Version ~= VERSION then
        b = { Version=VERSION, Enabled=false, Humanoid=nil, RootPart=nil, State=nil, WalkSpeed=MAX_SPEED*HEADROOM, TravelVelocity=Vector3.zero, NextSearchAt=0 }
        g[INTEGRITY_KEY] = b
    end
    return b
end

local function integrityEnable(hum, hrp, speed)
    local b = integrityBox()
    local now = os.clock()
    local st  = b.State
    local ok  = type(st) == "table"
        and rawget(st,"Player") == LP
        and rawget(st,"Character") == LP.Character
        and rawget(st,"Humanoid") == hum
        and rawget(st,"RootPart") == hrp

    if not ok then
        if now < (b.NextSearchAt or 0) then return false end
        b.NextSearchAt = now + 0.2
        st = findStateThrottled(LP, hum, hrp)
        if not st then return false end
        ok = rawget(st,"Humanoid") == hum and rawget(st,"RootPart") == hrp
        if not ok then
            b.Enabled=false; b.Humanoid=hum; b.RootPart=hrp; b.State=st
            return false
        end
    end

    b.NextSearchAt  = 0
    b.Enabled       = true
    b.Humanoid      = hum
    b.RootPart      = hrp
    b.State         = st
    b.WalkSpeed     = math.clamp(speed * HEADROOM, MIN_SPEED, MAX_SPEED * HEADROOM)
    b.TravelVelocity = Vector3.zero
    applyIntegrity(st, b.WalkSpeed, b.TravelVelocity)
    return true
end

local function integrityUpdate(hum, hrp, speed, travelVel)
    local b = genv[INTEGRITY_KEY]
    if type(b) ~= "table" or not b.Enabled or b.Humanoid ~= hum or b.RootPart ~= hrp then
        return false
    end
    b.WalkSpeed = math.clamp(speed * HEADROOM, MIN_SPEED, MAX_SPEED * HEADROOM)
    if typeof(travelVel) == "Vector3" then
        b.TravelVelocity = travelVel
    elseif typeof(b.TravelVelocity) ~= "Vector3" then
        b.TravelVelocity = Vector3.zero
    end
    return applyIntegrity(b.State, b.WalkSpeed, b.TravelVelocity)
end

local function integrityDisable(hum)
    local b = genv[INTEGRITY_KEY]
    if type(b) ~= "table" then return end
    if hum == nil or b.Humanoid == hum then
        b.Enabled=false; b.Humanoid=nil; b.RootPart=nil; b.State=nil; b.TravelVelocity=nil; b.NextSearchAt=0
    end
end

-- ===== hover pad =====
local hoverPart, hoverConn, hoverPost, hoverOwnerId
local HOVER_NAME = "__SenaStealHoverPad"

local function feetOffset(hrp, hum)
    if hum.RigType == Enum.HumanoidRigType.R15 then
        return hrp.Size.Y * 0.5 + math.max(hum.HipHeight, 0.5)
    end
    return hrp.Size.Y * 0.5 + 2
end

local function purgeOrphanPads()
    for _, c in ipairs(workspace:GetChildren()) do
        if c.Name == HOVER_NAME and c ~= hoverPart then
            pcall(function() c:Destroy() end)
        end
    end
end

local function syncHover(posOverride)
    if not hoverPart or not hoverPart.Parent or hoverPart:GetAttribute("Owner") ~= hoverOwnerId then
        return false
    end
    local char = LP.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return false end
    local pos = typeof(posOverride) == "Vector3" and posOverride or hrp.Position
    hoverPart.CFrame = cFrameNew(pos.X, pos.Y - feetOffset(hrp, hum) - 0.55, pos.Z)
    return true
end

local function startHoverPad()
    if not hoverPart or not hoverPart.Parent or hoverPart:GetAttribute("Owner") ~= hoverOwnerId then
        purgeOrphanPads()
        if hoverPart and hoverPart.Parent then pcall(function() hoverPart:Destroy() end) end
        hoverOwnerId = tostring(LP.UserId) .. ":" .. tostring(math.random(1e6))
        local p = Instance.new("Part")
        p.Name = HOVER_NAME
        p:SetAttribute("Owner", hoverOwnerId)
        p.Anchored = true; p.CanCollide = true; p.CanQuery = true
        p.CanTouch = false; p.CastShadow = false; p.Transparency = 1
        p.Material = Enum.Material.SmoothPlastic
        p.Size = Vector3.new(8, 1, 8)
        hoverPart = p; p.Parent = workspace
    end
    syncHover()
    if not hoverConn then
        hoverConn = RunService.PreSimulation:Connect(function()
            if not syncHover() then startHoverPad() end
        end)
    end
    if not hoverPost then
        hoverPost = RunService.PostSimulation:Connect(function() syncHover() end)
    end
end

local function stopHoverPad()
    if hoverConn then hoverConn:Disconnect(); hoverConn = nil end
    if hoverPost then hoverPost:Disconnect(); hoverPost = nil end
    if hoverPart then pcall(function() hoverPart:Destroy() end); hoverPart = nil end
    purgeOrphanPads()
end

-- ===== anti-ragdoll =====
local antiRagdollConn
local function installAntiRagdoll()
    if antiRagdollConn then return end
    antiRagdollConn = RunService.Heartbeat:Connect(function()
        if not CFG.enabled then return end
        local char = LP.Character
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        if hum.PlatformStand or hum.Sit or hum:GetState() == Enum.HumanoidStateType.Ragdoll then
            pcall(function()
                hum.BreakJointsOnDeath = false
                hum.RequiresNeck = false
                hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
                hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
                hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
                hum.PlatformStand = false
                hum.Sit = false
                hum:ChangeState(Enum.HumanoidStateType.Running)
            end)
        end
    end)
end

-- ===== movimento: teleport (Instant) / glide (Normal) =====
local function teleportRoot(cf, speed)
    local char = LP.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return false end

    startHoverPad()
    integrityEnable(hum, hrp, speed or CFG.speed)

    pcall(function()
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        hrp.CFrame = cf
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end)
    syncHover(cf.Position)
    integrityUpdate(hum, hrp, speed or CFG.speed, Vector3.zero)
    return true
end

local function glideRoot(cf, speed, abort)
    local char = LP.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return false end

    startHoverPad()
    integrityEnable(hum, hrp, speed or CFG.speed)

    local target  = cf.Position
    local s       = math.clamp(speed or CFG.speed, MIN_SPEED, MAX_SPEED)
    local tLimit  = os.clock() + math.clamp((target - hrp.Position).Magnitude / s * 1.6 + 6, 12, 90)

    while os.clock() < tLimit do
        if abort and abort() then return false end
        if CFG.enabled == false then return false end

        char = LP.Character
        hrp  = char and char:FindFirstChild("HumanoidRootPart")
        hum  = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then return false end

        local d    = target - hrp.Position
        local dist = d.Magnitude
        if dist <= 1 then
            hrp.CFrame = cf
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            syncHover(cf.Position)
            integrityUpdate(hum, hrp, s, Vector3.zero)
            return true
        end

        local dt   = math.max(math.min(RunService.Heartbeat:Wait(), 0.15), 0.00416666)
        local step = math.min(s * dt, dist)
        local newPos = hrp.Position + d.Unit * step

        pcall(function()
            hrp.CFrame = cFrameNew(newPos, newPos + d.Unit)
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end)
        syncHover(newPos)

        if not integrityUpdate(hum, hrp, s, d.Unit * s) then
            integrityEnable(hum, hrp, s)
            integrityUpdate(hum, hrp, s, d.Unit * s)
        end
    end
    return false
end

