-- ===== stealth loop com bypass =====
local running = false
local stealThread

local function pickRarity(rec)
    local ok, r = pcall(function()
        local Assets = require(ReplicatedStorage.Data.Assets)
        local cat = rec.AssetCategory
        local d = cat and Assets.Directory[cat]
        local rr = d and d.Rarity
        return rr and (rr.DisplayName or rr._id) or nil
    end)
    return ok and r or nil
end

local function passes(rec)
    local any = false
    for _ in pairs(CFG.rarities) do any = true; break end
    if not any then return true end
    local n = pickRarity(rec)
    if not n then return true end
    return CFG.rarities[n] == true
end

local SAFE = CFrame.new(544.76, 71.5, -416.48)

local function stealLoop()
    local EggState = require(ReplicatedStorage.Client.EggState)
    local Remotes  = require(ReplicatedStorage.Shared.Remotes)

    while CFG.enabled do
        local ok, snap = pcall(EggState.ReadFieldEggs)
        if not ok or not snap or not snap.Records then task.wait(0.5); continue end

        local target
        for _, rec in ipairs(snap.Records) do
            if (rec.State == "Slot" or rec.State == "Dropped")
            and rec.BottomCFrame and passes(rec) then
                target = rec; break
            end
        end
        if not target then task.wait(0.4); continue end

        local char = LP.Character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then task.wait(0.3); continue end

        local dest = CFrame.new(target.BottomCFrame.Position + Vector3.new(0,3,0))

        if CFG.method == "Instant" then
            teleportRoot(dest, CFG.speed)
        else
            glideRoot(dest, CFG.speed, function() return not CFG.enabled end)
        end
        if not CFG.enabled then break end
        task.wait(0.1)

        pcall(function()
            Remotes.EggWorld.AskFieldEggCarry:InvokeServer({ Uid = target.Uid })
        end)
        task.wait(CFG.method == "Instant" and 0.4 or 1.0)
        if not CFG.enabled then break end

        local safeDest = SAFE * CFrame.new(0,3,0)
        if CFG.method == "Instant" then
            teleportRoot(safeDest, CFG.speed)
        else
            glideRoot(safeDest, CFG.speed, function() return not CFG.enabled end)
        end
        task.wait(0.3)
    end
end

local function start()
    if running then return end
    running = true
    CFG.enabled = true
    paintSwitch()

    -- liga bypass
    installAntiRagdoll()
    local char = LP.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if hum and hrp then
        startHoverPad()
        integrityEnable(hum, hrp, CFG.speed)
    end

    stealThread = task.spawn(function()
        local ok, err = pcall(stealLoop)
        running = false
        CFG.enabled = false
        paintSwitch()
        -- desliga bypass
        stopHoverPad()
        integrityDisable()
        if not ok then warn("[Sena Steal] " .. tostring(err)) end
    end)
end

local function stop()
    CFG.enabled = false
    paintSwitch()
    stopHoverPad()
    integrityDisable()
    if stealThread then pcall(task.cancel, stealThread); stealThread = nil end
    running = false
end

switch.MouseButton1Click:Connect(function()
