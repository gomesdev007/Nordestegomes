local function restorePlayerControls(hum)
    pcall(function()
        local ps = LP:FindFirstChild("PlayerScripts")
        local pm = ps and ps:FindFirstChild("PlayerModule")
        if pm then
            local ok, controls = pcall(function() return require(pm):GetControls() end)
            if ok and type(controls) == "table" then
                controls.humanoid = hum
                if controls.controlsEnabled == false then
                    pcall(function() controls:Enable() end)
                end
            end
        end
    end)
end

local function pulseAnimate(char)
    pcall(function()
        local a = char and char:FindFirstChild("Animate")
        if a and a:IsA("LocalScript") then
            task.spawn(function()
                a.Enabled = false
                task.wait()
                a.Enabled = true
            end)
        end
    end)
end

local function clearLinks()
    for _, c in ipairs(shieldState.Links) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(shieldState.Links)
end

local function reEnableMonitor()
    for _, c in ipairs(shieldState.DisabledConns) do
        pcall(function() c:Enable() end)
    end
    table.clear(shieldState.DisabledConns)
end

local function findMonitors()
    if type(getconnections) ~= "function" then return end
    for _, sig in ipairs({RunService.Heartbeat, RunService.PreSimulation, RunService.PostSimulation}) do
        local ok, list = pcall(getconnections, sig)
        if ok and type(list) == "table" then
            for _, conn in ipairs(list) do
                local okF, fn = pcall(function() return conn.Function end)
                if okF and type(fn) == "function" then
                    local okN, name = pcall(debug.info, fn, "s")
                    if okN and string.find(tostring(name), "UGI", 1, true) then
                        local okE, en = pcall(function() return conn.Enabled end)
                        if not okE or en ~= false then
                            if pcall(function() conn:Disable() end) then
                                table.insert(shieldState.DisabledConns, conn)
                            end
                        end
                    end
                end
            end
        end
    end
end

local function disableMonitor()
    findMonitors()
end

local function doSwap()
    local char, hum = LP.Character, nil
    if char then hum = char:FindFirstChildOfClass("Humanoid") end
    if not hum or hum.Health <= 0 then return false end
    if shieldState.Clone and shieldState.Clone.Parent == char then return true end
    if not grounded(hum) then return false end

    local clone = hum:Clone()
    hum.Parent = nil
    clone.Parent = char
    Workspace.CurrentCamera.CameraSubject = clone
    restorePlayerControls(clone)
    pulseAnimate(char)

    shieldState.Original = hum
    shieldState.Clone = clone

    table.insert(shieldState.Links, hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
        if clone.Parent then clone.WalkSpeed = hum.WalkSpeed end
    end))

    local a1 = hum:FindFirstChildOfClass("Animator")
    local a2 = clone:FindFirstChildOfClass("Animator")
    if a1 and a2 then
        table.insert(shieldState.Links, a1.AnimationPlayed:Connect(function(track)
            local anim = track.Animation
            if not anim or clone.Parent == nil then return end
            local ok, loaded = pcall(function() return a2:LoadAnimation(anim) end)
            if ok and loaded then
                pcall(function()
                    loaded.Priority = track.Priority
                    loaded.Looped = track.Looped
                    loaded:Play(0.05, math.max(track.WeightTarget, 0.01), track.Speed)
                end)
                local c
                c = track.Stopped:Connect(function()
                    c:Disconnect()
                    pcall(function() loaded:Stop(0.1) end)
                end)
            end
        end))
    end

    table.insert(shieldState.Links, clone.Died:Connect(function()
        clearLinks()
        local orig = shieldState.Original
        local cl = shieldState.Clone
        shieldState.Original = nil
        shieldState.Clone = nil
        local c2 = LP.Character
        if c2 and orig and orig.Parent == nil then
            orig.Parent = c2
            Workspace.CurrentCamera.CameraSubject = orig
            restorePlayerControls(orig)
        end
        if cl then pcall(function() cl:Destroy() end) end
        if orig then orig.Health = 0 end
    end))

    return true
end

local function undoSwap()
    clearLinks()
    local char = LP.Character
    local orig = shieldState.Original
    local clone = shieldState.Clone
    shieldState.Original = nil
    shieldState.Clone = nil
    if orig and clone and char and orig.Parent == nil and clone.Parent == char then
        orig.Parent = char
        Workspace.CurrentCamera.CameraSubject = orig
        restorePlayerControls(orig)
        pcall(function() clone:Destroy() end)
        pulseAnimate(char)
    end
end

local function useShield()
    if shieldState.Active then return end
    shieldState.Active = true

    if shieldState.Method == "Humanoid Swap" or shieldState.Method == "Auto" then
        if shieldState.CanSwap and doSwap() then
            shieldState.Method = "Humanoid Swap"
            return
        end
    end
    if shieldState.Method == "Disable Monitor" or shieldState.Method == "Auto" then
        shieldState.Method = "Disable Monitor"
        disableMonitor()
    end
end

local function releaseShield()
    if not shieldState.Active then return end
    shieldState.Active = false
    undoSwap()
    reEnableMonitor()
    shieldState.Method = "Auto"
end

