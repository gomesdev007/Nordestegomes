    nameLbl.TextColor3 = Color3.fromRGB(240, 245, 255)
    nameLbl.TextSize = 13
    nameLbl.Font = Enum.Font.GothamBold
    nameLbl.TextXAlignment = Enum.TextXAlignment.Left
    nameLbl.TextTruncate = Enum.TextTruncate.AtEnd
    nameLbl.Parent = card

    local rateLbl = Instance.new("TextLabel")
    rateLbl.Size = UDim2.new(1, -92, 0, 18)
    rateLbl.Position = UDim2.new(0, 88, 0, 34)
    rateLbl.BackgroundTransparency = 1
    rateLbl.Text = "$" .. formatMoney(entry.Info.Rate) .. "/s"
    rateLbl.TextColor3 = Color3.fromRGB(80, 255, 140)
    rateLbl.TextSize = 14
    rateLbl.Font = Enum.Font.GothamBold
    rateLbl.TextXAlignment = Enum.TextXAlignment.Left
    rateLbl.Parent = card

    local rarityLbl = Instance.new("TextLabel")
    rarityLbl.Size = UDim2.new(1, -92, 0, 14)
    rarityLbl.Position = UDim2.new(0, 88, 0, 56)
    rarityLbl.BackgroundTransparency = 1
    rarityLbl.Text = string.upper(entry.Info.Rarity)
    rarityLbl.TextColor3 = entry.Info.RarityColor
    rarityLbl.TextSize = 11
    rarityLbl.Font = Enum.Font.GothamBold
    rarityLbl.TextXAlignment = Enum.TextXAlignment.Left
    rarityLbl.TextTruncate = Enum.TextTruncate.AtEnd
    rarityLbl.Parent = card

    cardStrokes[card] = stroke

    card.MouseButton1Click:Connect(function()
        if not entry.Position then return end

        SELECTED = entry

        for c, s in pairs(cardStrokes) do
            if c == card then
                s.Color = ACCENT
                s.Thickness = 2.5
                s.Transparency = 0
            else
                s.Thickness = 1.5
                s.Transparency = 0.3
            end
        end

        local modeTxt = CURRENT_MODE == "TP" and "TP" or "voando"
        setStatus("Indo ate " .. entry.Info.Name .. " (" .. modeTxt .. ")", ACCENT2)

        task.spawn(function()
            local ok = goTo(entry.Position, function(success)
                if success then
                    setStatus("Chegou em " .. entry.Info.Name, ACCENT2)
                else
                    setStatus("Falhou ao ir", Color3.fromRGB(255, 120, 120))
                end
            end)
            if not ok then
                setStatus("Nao foi possivel ir", Color3.fromRGB(255, 120, 120))
            end
        end)
    end)

    card.MouseEnter:Connect(function()
        if SELECTED ~= entry then
            stroke.Transparency = 0
        end
    end)
    card.MouseLeave:Connect(function()
        if SELECTED ~= entry then
            stroke.Transparency = 0.3
        end
    end)

    return card
end

local function clearCards()
    for _, c in ipairs(cards) do
        pcall(function() c:Destroy() end)
    end
    table.clear(cards)
    table.clear(cardStrokes)
end

local function render()
    local eggs = getFieldEggs()
    counter.Text = tostring(#eggs)

    if #eggs == 0 then
        setStatus("Event " .. EVENT_MODE .. " - sem ovos", Color3.fromRGB(255, 180, 80))
        clearCards()
        updateCanvas()
        return
    end

    setStatus("Event " .. EVENT_MODE .. " - " .. #eggs .. " ovos", ACCENT2)

    local prevSelectedUid = SELECTED and SELECTED.Uid
    clearCards()

    for i, entry in ipairs(eggs) do
        local card = makeCard(entry)
        card.LayoutOrder = i
        cards[i] = card

        if entry.Uid == prevSelectedUid then
            SELECTED = entry
            local stroke = cardStrokes[card]
            if stroke then
                stroke.Color = ACCENT
                stroke.Thickness = 2.5
                stroke.Transparency = 0
            end
        end
    end

    updateCanvas()
end

render()

task.spawn(function()
    while true do
        task.wait(3)
        pcall(render)
    end
end)

