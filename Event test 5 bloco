local function formatMoney(n)
    n = tonumber(n) or 0
    if n >= 1e12 then
        return string.format("%.2fT", n / 1e12)
    elseif n >= 1e9 then
        return string.format("%.2fB", n / 1e9)
    elseif n >= 1e6 then
        return string.format("%.2fM", n / 1e6)
    elseif n >= 1e3 then
        return string.format("%.1fK", n / 1e3)
    end
    return string.format("%.0f", n)
end

local function getAssetInfo(category)
    if not Assets or type(Assets.Directory) ~= "table" then
        return nil
    end
    local info = Assets.Directory[category]
    if type(info) ~= "table" then return nil end

    local name = info.DisplayName or category
    local icon = info.Icon
    local rate = tonumber(info.EarningRate) or 0
    local rarity = nil
    local rarityColor = Color3.fromRGB(255, 255, 255)
    local rarityNum = 0

    if type(info.Rarity) == "table" then
        rarity = info.Rarity.DisplayName or info.Rarity._id or "Comum"
        rarityNum = tonumber(info.Rarity.RarityNumber or info.Rarity.Rank) or 0
        if typeof(info.Rarity.Color) == "Color3" then
            rarityColor = info.Rarity.Color
        end
    else
        rarity = "Comum"
    end

    if icon and tonumber(icon) then
        icon = "rbxassetid://" .. tostring(icon)
    end

    return {
        Name = tostring(name),
        Icon = icon and tostring(icon) or nil,
        Rate = rate,
        Rarity = tostring(rarity),
        RarityColor = rarityColor,
        RarityNum = rarityNum,
    }
end

local function getFieldEggs()
    local records = nil

    if EggState and type(EggState.ReadFieldEggs) == "function" then
        local ok, res = pcall(EggState.ReadFieldEggs)
        if ok and type(res) == "table" and type(res.Records) == "table" then
            records = res.Records
        end
    end

    if not records and AskFieldEggSnapshot and AskFieldEggSnapshot:IsA("RemoteFunction") then
        local ok, res = pcall(AskFieldEggSnapshot.InvokeServer, AskFieldEggSnapshot)
        if ok and type(res) == "table" and type(res.Records) == "table" then
            records = res.Records
        end
    end

    if type(records) ~= "table" then return {} end

    local list = {}
    for uid, rec in pairs(records) do
        if type(rec) == "table" then
            local state = rec.State
            if state == "Slot" or state == "Dropped" then
                local pos = nil
                if typeof(rec.BottomCFrame) == "CFrame" then
                    pos = rec.BottomCFrame.Position
                end
                if pos then
                    local info = getAssetInfo(rec.AssetCategory)
                    if info then
                        list[#list + 1] = {
                            Uid = tostring(uid),
                            Category = rec.AssetCategory,
                            Position = pos,
                            Info = info,
                        }
                    end
                end
            end
        end
    end

    table.sort(list, function(a, b)
        return (a.Info.Rate or 0) > (b.Info.Rate or 0)
    end)

    return list
end

local function goTo(position, doneFn)
    if CURRENT_MODE == "TP" then
        local ok = tpTo(position)
        if doneFn then pcall(doneFn, ok) end
        return ok
    end
    return startFly(position, doneFn)
end

