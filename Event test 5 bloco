local PROPS_TO_COPY = {
    "WalkSpeed","JumpPower","JumpHeight","AutoRotate","HipHeight",
    "MaxHealth","Health","NameDisplayDistance","HealthDisplayDistance",
    "DisplayDistanceType","RigType","UseJumpPower","PlatformStand",
