function Bypass.Apply(character)
    if Bypass.Active or not character or not character.Parent then
        return false
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false end

    local clone = humanoid:Clone()
    clone.Name = humanoid.Name
    clone.Parent = character

    for _, property in ipairs(PROPS_TO_COPY) do
        pcall(function()
            clone[property] = humanoid[property]
        end)
    end

    for name, value in pairs(humanoid:GetAttributes()) do
        pcall(function()
            clone:SetAttribute(name, value)
        end)
    end

    local animator = humanoid:FindFirstChildOfClass("Animator")
    if animator then animator.Parent = clone end

    Bypass.OriginalHumanoid = humanoid
    Bypass.CloneHumanoid = clone
    Bypass.Active = true

    pcall(function()
        Workspace.CurrentCamera.CameraSubject = clone
    end)

    humanoid:Destroy()
    return true
end

function Bypass.Disable()
    Bypass.Active = false
    Bypass.OriginalHumanoid = nil
    Bypass.CloneHumanoid = nil

    local character = LP.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        pcall(function()
            Workspace.CurrentCamera.CameraSubject = humanoid
        end)
    end
end

