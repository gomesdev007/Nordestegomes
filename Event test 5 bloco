local function runOriginalEvent()
    if eventRunning or IsTeleporting then return end
    eventRunning = true
    IsTeleporting = true

    setStatus("Event Original rodando", ACCENT2)
    showOverlay("EVENT TEST...")

    task.spawn(function()
        local char = LP.Character
        if not char or not char.Parent then
            eventRunning = false
            IsTeleporting = false
            hideOverlay()
            return
        end

        pcall(function() Bypass.Apply(char) end)

        for _, position in ipairs(TeleportPoints) do
            local c = LP.Character
            if not c or not c.Parent then break end
            pcall(function() c:PivotTo(CFrame.new(position)) end)
            task.wait(0.08)
        end

        local c = LP.Character
        if c and c.Parent and savedPromptPos then
            local target = savedPromptRot
                and (CFrame.new(savedPromptPos) * savedPromptRot)
                or CFrame.new(savedPromptPos)
            pcall(function() c:PivotTo(target) end)
            task.wait(0.15)
        end

        hideOverlay()
        IsTeleporting = false

        if savedPromptPos then
            startTest()
            setStatus("Posicao 9 concluida - TEST ativo", ACCENT2)
        else
            setStatus("Sem posicao salva", Color3.fromRGB(255, 180, 80))
        end

        eventRunning = false
    end)
end

local function runTPEvent()
    if eventRunning or IsTeleporting then return end
    eventRunning = true
    IsTeleporting = true

    setStatus("TP Event indo pra posicao inicial", ACCENT2)
    showOverlay("TP EVENT...")

    task.spawn(function()
        local returnPos = savedPromptPos
        local returnRot = savedPromptRot

        if not returnPos then
            setStatus("Sem posicao pra voltar", Color3.fromRGB(255, 180, 80))
            hideOverlay()
            eventRunning = false
            IsTeleporting = false
            return
        end

        local c = LP.Character
        if c then pcall(function() Bypass.Apply(c) end) end

        if SCRIPT_START then
            local c2 = LP.Character
            if c2 and c2.Parent then
                pcall(function() c2:PivotTo(SCRIPT_START) end)
            end
            setStatus("TP Event esperando 2s", ACCENT2)
            task.wait(2)
        end

        local c3 = LP.Character
        if c3 and c3.Parent then
            local target = returnRot
                and (CFrame.new(returnPos) * returnRot)
                or CFrame.new(returnPos)
            pcall(function() c3:PivotTo(target) end)
            task.wait(0.15)
        end

        hideOverlay()
        IsTeleporting = false
        setStatus("TP Event voltou pra posicao do prompt", ACCENT2)
        eventRunning = false
    end)
end

local function runEvent()
    if EVENT_MODE == "Modo Original" then
        runOriginalEvent()
    else
        runTPEvent()
    end
end

-- ============ AUTO PROMPT ============
local function findNearestPrompt(origin, radius)
    local best, bestDist = nil, radius
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("ProximityPrompt") and d.Enabled and d.Parent then
            local cd = promptCooldown[d]
            if not cd or os.clock() >= cd then
                local part = d.Parent
                if part:IsA("BasePart") then
                    local dist = (part.Position - origin).Magnitude
                    if dist < bestDist then
                        best, bestDist = d, dist
                    end
                elseif part:IsA("Attachment") then
                    local dist = (part.WorldPosition - origin).Magnitude
                    if dist < bestDist then
                        best, bestDist = d, dist
                    end
                end
            end
        end
    end
    return best
end

local function firePrompt(prompt)
    promptCooldown[prompt] = os.clock() + PROMPT_COOLDOWN_TIME
    task.spawn(function()
        pcall(function() prompt.HoldDuration = 0 end)
        if typeof(fireproximityprompt) == "function" then
            pcall(fireproximityprompt, prompt)
        end
        pcall(function()
            prompt:InputHoldBegin()
            task.wait(0.05)
            prompt:InputHoldEnd()
        end)
    end)
end

local function startPromptListener()
    if promptConn then promptConn:Disconnect() promptConn = nil end
    promptConn = RunService.Heartbeat:Connect(function()
        if not SELECTED then return end
        local prompt = findNearestPrompt(SELECTED.Position, promptRadius)
        if prompt then
            firePrompt(prompt)
        end
    end)
end

