                h2.PlatformStand = false
                h2:ChangeState(Enum.HumanoidStateType.Running)
            end)
            restorePlayerControls(h2)
        end
    end)
end

function startFly(goal, doneFn)
    if flying then stopFly() end
    local hrp, hum, char = root()
    if not hrp or not hum or not char then return false end

    unragdoll(hum, char)
    task.wait(0.15)

    hrp, hum, char = root()
    if not hrp or not hum then return false end

    local origPlatform = hum.PlatformStand
    local origAuto = hum.AutoRotate
    local origBJD = hum.BreakJointsOnDeath
    local origNeck = hum.RequiresNeck

    pcall(function()
        hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.Physics, true)
        hum.BreakJointsOnDeath = false
        hum.RequiresNeck = false
        hum.PlatformStand = true
        hum.AutoRotate = false
        hum:UnequipTools()
        hum:ChangeState(Enum.HumanoidStateType.Physics)
    end)

    useShield()
    task.wait(0.1)

    startTest()

    local activeHum = getActiveHumanoid() or hum
    local activeChar = LP.Character

    pcall(function()
        local cam = Workspace.CurrentCamera
        if cam then
            cam.CameraSubject = activeHum
            cam.CameraType = Enum.CameraType.Custom
        end
    end)

    for _, d in ipairs(activeChar:GetDescendants()) do
        if d:IsA("BasePart") then
            pcall(function() d.CanCollide = false end)
        end
    end

    local position = hrp.Position
    local rotation = hrp.CFrame.Rotation
    local startChar = activeChar

    flyData = {
        Goal = goal,
        Position = position,
        Rotation = rotation,
        Character = startChar,
        Hum = activeHum,
        OrigHum = hum,
        OrigState = {
            PlatformStand = origPlatform,
            AutoRotate = origAuto,
            BreakJointsOnDeath = origBJD,
            RequiresNeck = origNeck,
        },
        Done = doneFn,
        StallTime = 0,
        StallPos = position,
    }
    flying = true

    flyData.Pre = RunService.PreSimulation:Connect(function(dt)
        local d = flyData
        if not d then return end
        local c = LP.Character
        if c ~= d.Character or not c or not c.Parent then stopFly() return end
        local cur = c:FindFirstChild("HumanoidRootPart")
        local h = c:FindFirstChildOfClass("Humanoid")
        if not cur or not h or h.Health <= 0 then stopFly() return end

        if h.PlatformStand ~= true then
            pcall(function()
                h.PlatformStand = true
                h:ChangeState(Enum.HumanoidStateType.Physics)
            end)
        end

        local diff = d.Goal - d.Position
        local mag = diff.Magnitude
        if mag <= 3 then
            local cb = d.Done
            stopFly()
            if cb then pcall(cb, true) end
            return
        end

        local step = math.min(CFG.Speed * dt, mag)
        d.Position = d.Position + diff.Unit * step

        local look = d.Goal - d.Position
        local flat = Vector3.new(look.X, 0, look.Z)
        if flat.Magnitude > 0.05 then
            d.Rotation = CFrame.lookAt(Vector3.zero, flat.Unit).Rotation
        end

        pcall(function()
            cur.CFrame = CFrame.new(d.Position) * d.Rotation
            cur.AssemblyLinearVelocity = Vector3.new(0, -Workspace.Gravity * 0.02, 0)
            cur.AssemblyAngularVelocity = Vector3.zero
        end)
    end)

    flyData.HB = RunService.Heartbeat:Connect(function(dt)
        local d = flyData
        if not d then return end
        local c = LP.Character
        if not c or c ~= d.Character then return end
        local cur = c:FindFirstChild("HumanoidRootPart")
        if not cur then return end

        local diff = d.Position - cur.Position
        if diff.Magnitude > 6 then
            pcall(function()
                cur.CFrame = CFrame.new(d.Position) * d.Rotation
                cur.AssemblyLinearVelocity = Vector3.new(0, -Workspace.Gravity * 0.02, 0)
                cur.AssemblyAngularVelocity = Vector3.zero
            end)
        end

        if (cur.Position - d.StallPos).Magnitude < 1 then
            d.StallTime = d.StallTime + dt
            if d.StallTime > 1.2 then
                pcall(function()
                    local push = d.Goal - cur.Position
                    if push.Magnitude > 0.1 then
                        cur.CFrame = CFrame.new(cur.Position + push.Unit * 6) * d.Rotation
                    end
                end)
                d.StallTime = 0
            end
        else
            d.StallTime = 0
        end
        d.StallPos = cur.Position

        local rem = tonumber(LP:GetAttribute("RagdollEndTime"))
        if rem and rem > Workspace:GetServerTimeNow() then
            LP:SetAttribute("RagdollEndTime", 0)
            pcall(function()
                local h = c:FindFirstChildOfClass("Humanoid")
                if h then
                    h:ChangeState(Enum.HumanoidStateType.Physics)
                    h.PlatformStand = true
                end
            end)
        end

        if shieldState.Method == "Disable Monitor" then
            if #shieldState.DisabledConns > 0 and math.random(1, 30) == 1 then
                findMonitors()
            end
        end

        if (cur.Position - d.Goal).Magnitude <= 3 then
            local cb = d.Done
            stopFly()
            if cb then pcall(cb, true) end
        end
    end)

    flyData.CamConn = RunService.RenderStepped:Connect(function()
        local d = flyData
        if not d then return end
        local cam = Workspace.CurrentCamera
        if not cam then return end
        if cam.CameraType ~= Enum.CameraType.Custom then
            cam.CameraType = Enum.CameraType.Custom
        end
        if cam.CameraSubject ~= d.Hum then
            cam.CameraSubject = d.Hum
        end
    end)

    return true
end

function tpTo(position)
    local hrp, hum, char = root()
    if not char or not position then return false end

    if shieldState.Active then releaseShield() end

    pcall(function()
        hum.BreakJointsOnDeath = false
        hum.RequiresNeck = false
        hum.PlatformStand = true
        hum:ChangeState(Enum.HumanoidStateType.Physics)
    end)

    useShield()
    task.wait(0.08)

    startTest()

    local activeChar = LP.Character
    if not activeChar then return false end

    pcall(function()
        activeChar:PivotTo(CFrame.new(position + Vector3.new(0, 3, 0)))
    end)

    task.wait(0.1)

    releaseShield()
    stopTest()

    local h = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
    if h then
        pcall(function()
            h.PlatformStand = false
            h:ChangeState(Enum.HumanoidStateType.Running)
            h:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
            h:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
            h:SetStateEnabled(Enum.HumanoidStateType.Physics, true)
            h.BreakJointsOnDeath = true
            h.RequiresNeck = true
        end)
    end

    return true
end

