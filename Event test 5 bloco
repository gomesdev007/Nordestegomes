local function root()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart"), c and c:FindFirstChildOfClass("Humanoid"), c
end

local function grounded(hum)
    if not hum then return false end
    if hum.FloorMaterial == Enum.Material.Air then return false end
    local s = hum:GetState()
    return s == Enum.HumanoidStateType.Running
        or s == Enum.HumanoidStateType.RunningNoPhysics
        or s == Enum.HumanoidStateType.Landed
end

