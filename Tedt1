local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer

local BypassEnabled = true
local IsTeleporting = false
local IsTesting = false
local TestConnection = nil
local TestHeight = nil
local LastPromptPosition = nil
local ExecutePosition = nil

local characterAtStart = LocalPlayer.Character
if characterAtStart then
    local rootAtStart = characterAtStart:FindFirstChild("HumanoidRootPart")
    if rootAtStart then
        ExecutePosition = rootAtStart.CFrame
    else
        ExecutePosition = characterAtStart:GetPivot()
    end
end

local TeleportPoints = {
    Vector3.new(500.62, 241.28, -366.64),
    Vector3.new(504.45, 155.80, -366.35),
    Vector3.new(508.30, 70.28, -366.03),
